# =============================================================
# VARIABLES DE ENTORNO — COPIA ESTE ARCHIVO A .env.local
# =============================================================
# Nunca comitas el archivo .env.local al repositorio.

# ─── Base de datos ──────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB_NAME?sslmode=require"

# ─── NextAuth v5 ────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET="CAMBIA_ESTO_POR_UN_VALOR_SEGURO_DE_32+_CARACTERES"
# URL pública del sitio (sin barra final)
NEXTAUTH_URL="http://localhost:3000"

# ─── URL pública (usada por Stripe y Webpay para return URLs) ─
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ─── Stripe ─────────────────────────────────────────────────
# Obtén las keys en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret (configurar en https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Webpay / Transbank ──────────────────────────────────────
# Integración (desarrollo): usa los valores de prueba de Transbank
WEBPAY_COMMERCE_CODE="597055555532"
WEBPAY_API_KEY="579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C"
# Para producción: usa las credenciales reales de Transbank
# WEBPAY_COMMERCE_CODE="TU_COMMERCE_CODE"
# WEBPAY_API_KEY="TU_API_KEY"

# ─── Email (Resend) ──────────────────────────────────────────
# Obtén tu API key en https://resend.com/api-keys
# Si no está configurada, los emails se omiten silenciosamente
RESEND_API_KEY="re_..."
# Dirección remitente (debe estar verificada en Resend)
RESEND_FROM_EMAIL="noreply@tudominio.com"

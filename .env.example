# =============================================================
# VARIABLES DE ENTORNO — COPIA ESTE ARCHIVO A .env.local
# =============================================================
# Nunca comitas el archivo .env.local al repositorio.

# ─── Base de datos ──────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB_NAME?sslmode=require"

# ─── NextAuth v5 ────────────────────────────────────────────
# Genera con: openssl rand -base64 32
AUTH_SECRET="CAMBIA_ESTO_POR_UN_VALOR_SEGURO_DE_32+_CARACTERES"
# URL pública del sitio (sin barra final)
NEXTAUTH_URL="https://tudominio.com"

# ─── URL pública (usada por Stripe y Webpay para return URLs) ─
NEXT_PUBLIC_APP_URL="https://tudominio.com"

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ─── Stripe (Chile / CLP) ───────────────────────────────────
# Obtén las keys en https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Webhook secret (configurar endpoint https://tudominio.com/api/webhook/stripe)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Webpay / Transbank ──────────────────────────────────────
# Integración / Pruebas:
# WEBPAY_COMMERCE_CODE="597055555532"
# WEBPAY_API_KEY="579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C"
# WEBPAY_API_BASE_URL="https://webpay3gint.transbank.cl"
#
# Producción (credenciales oficiales emitidas por Transbank):
WEBPAY_COMMERCE_CODE="TU_CODIGO_COMERCIO_PRODUCCION"
WEBPAY_API_KEY="TU_API_KEY_PRODUCCION"
WEBPAY_API_BASE_URL="https://webpay3g.transbank.cl"

# ─── Email (Resend) ──────────────────────────────────────────
# Obtén tu API key en https://resend.com/api-keys
# Si no está configurada, los emails se omiten silenciosamente sin romper el checkout
RESEND_API_KEY="re_..."
# Dirección remitente (debe estar verificada en Resend con tu dominio propio)
RESEND_FROM_EMAIL="contacto@tudominio.com"

# ─── Semilla de Base de Datos (Opcional) ──────────────────────
# Credenciales del usuario administrador creado al ejecutar prisma db seed
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD="Tu_Password_Admin_Seguro_Aqui"
# Solo requerida si ejecutas db seed en entorno con NODE_ENV=production:
# FORCE_SEED="I_KNOW_THIS_WILL_DELETE_ALL_DATA"
